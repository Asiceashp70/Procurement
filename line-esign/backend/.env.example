# ---- LINE e-Sign API ----
NODE_ENV=development
PORT=3100
# Public URL of the web app (also used for LINE links and the Origin check)
APP_ORIGIN=http://localhost:5173
# Public URL of the API as the browser/LINE sees it. LINE Login callback = API_BASE_URL/auth/line/callback
API_BASE_URL=http://localhost:5173/api
DATABASE_URL=postgres://esign:esign_dev@localhost:5432/esign

# openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-1234
# openssl rand -base64 32   (losing this key makes stored signatures unreadable: back it up separately)
FILE_ENCRYPTION_KEY=
STORAGE_DIR=./storage

# LINE Login channel and Messaging API channel must be under the SAME provider (same userId)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
LINE_OA_BASIC_ID=@yourOA
LINE_PUSH_ENABLED=false

# LINE userIds of Super Admins (comma-separated). Nobody becomes Super Admin by logging in first.
SUPER_ADMIN_LINE_USER_IDS=

# Local testing only: log in by typing a LINE userId. Never enable in production.
DEV_LOGIN_ENABLED=true
JOB_WORKER_ENABLED=true
PDPA_CONSENT_VERSION=2026-11-v1

{
  "name": "line-esign-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LINE e-Sign API (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "nest build && node dist/db/migrate-cli.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.4.0",
    "@signpdf/signer-p12": "^3.4.0",
    "@signpdf/signpdf": "^3.4.0",
    "@signpdf/utils": "^3.4.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.0",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts",
      "<rootDir>/src/**/*.spec.ts"
    ],
    "testTimeout": 30000
  }
}
